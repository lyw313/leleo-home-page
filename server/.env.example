PORT=8787
NODE_ENV=development
# 生产若走纯 HTTP，设 COOKIE_SECURE=0；启用 HTTPS 后设为 1
# COOKIE_SECURE=0

# PostgreSQL（宝塔 / 本地 Docker）
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/leleo_homepage?schema=public"

# 未配置 DATABASE_URL 或连不上库时，自动降级为 server/data/*.json
# FORCE_JSON_STORE=1

# 管理员（首次启动会写入库；JSON 模式则校验此明文/哈希）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=0313

# Session
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=2

# 生产站域名，用于 Cookie / CORS（本地可空）
# CORS_ORIGIN=https://your.domain.com
